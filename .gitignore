# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store

# Generated outputs (regenerable: solvers / visualize.py / build_twin_html*.py)
# Ignore everything in outputs/ EXCEPT the shippable AR deliverable (kept tracked).
# NB: use "outputs/*" (not "outputs/") so the negation below can re-include a file.
outputs/*
!outputs/digital_twin_fem.html

# Local-only source PDFs (problem brief / Aufgabenstellung)
*.pdf

# Local secrets (API keys) — entire folder never committed. build_twin_html_fem.py
# reads GOOGLE_WEATHER_API_KEY from local/.env.local at build time; falls back
# to a placeholder if absent. Whole folder ignored so any future local-only
# secret file dropped in here is covered automatically.
local/

# Personal editor/tool config — not shared project config.
# .claude/settings.json (the PreToolUse secret-scan hook) stays tracked.
.claude/settings.local.json
.vscode/
